<style>
  :root{
    --bg: #10131f;
    --bg-2: #171b2b;
    --card: #1b2036;
    --card-border: #2a3050;
    --ink: #eef0f7;
    --ink-dim: #a7adc4;
    --amber: #e8a33d;
    --amber-soft: #f3c47a;
    --teal: #3fb6a8;
    --line: #2a3050;
    --radius-lg: 22px;
    --radius-sm: 12px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: radial-gradient(1200px 600px at 85% -10%, #1c2340 0%, var(--bg) 55%), var(--bg);
    color: var(--ink);
    font-family: 'Vazirmatn', sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}

  header{
    display:flex;align-items:center;justify-content:space-between;
    padding: 22px clamp(20px,5vw,64px);
    border-bottom: 1px solid var(--line);
    position: sticky; top:0; z-index: 50;
    background: rgba(16,19,31,0.85);
    backdrop-filter: blur(10px);
  }
  .logo{
    font-weight:900; font-size: 1.5rem; letter-spacing: -0.5px;
    display:flex; align-items:center; gap:10px;
  }
  .logo-mark{
    width:34px;height:34px;border-radius:10px;
    background: linear-gradient(135deg, var(--amber), var(--teal));
    display:flex;align-items:center;justify-content:center;
    font-size:1.1rem; color:#10131f; font-weight:900;
  }
  nav{display:flex; gap:28px; font-weight:500; color:var(--ink-dim);}
  nav a:hover{color:var(--ink);}
  .header-actions{display:flex;gap:14px;align-items:center;}
  .icon-btn{
    width:40px;height:40px;border-radius:50%;
    border:1px solid var(--line); display:flex;align-items:center;justify-content:center;
    color:var(--ink-dim); font-size:1.1rem;
  }
  @media (max-width: 860px){ nav{display:none;} }

  .hero{
    padding: clamp(50px,8vw,100px) clamp(20px,5vw,64px) clamp(30px,5vw,60px);
    display:grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items:center;
  }
  @media (max-width: 900px){ .hero{grid-template-columns:1fr;} }
  .eyebrow-line{
    display:flex; align-items:center; gap:10px; color:var(--amber-soft); font-weight:600; margin-bottom:18px; font-size:0.95rem;
  }
  .eyebrow-line span.dot{width:7px;height:7px;border-radius:50%;background:var(--amber);}
  h1{
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 800; letter-spacing:-1px; margin:0 0 22px;
  }
  .hero p.lead{ color: var(--ink-dim); font-size:1.15rem; max-width:520px; margin:0 0 32px;}
  .search-bar{
    display:flex; gap:10px; background: var(--card); border:1px solid var(--card-border);
    border-radius: 999px; padding: 8px 8px 8px 22px; max-width: 480px;
  }
  .search-bar input{
    flex:1; background:transparent; border:none; outline:none; color:var(--ink); font-family:inherit; font-size:1rem;
  }
  .search-bar input::placeholder{color:var(--ink-dim);}
  .search-bar button{
    background: var(--amber); color:#10131f; border:none; border-radius:999px;
    padding: 12px 26px; font-weight:700; font-family:inherit; cursor:pointer; font-size:0.95rem;
  }
  .cats-row{display:flex; flex-wrap:wrap; gap:10px; margin-top:26px;}
  .cat-chip{
    padding: 9px 18px; border-radius: 999px; border:1px solid var(--line);
    color: var(--ink-dim); font-size:0.9rem; font-weight:500;
  }

  .hero-visual{
    position:relative; aspect-ratio: 1/1; border-radius: var(--radius-lg);
    background: linear-gradient(160deg, #202748, #14182a 70%);
    border:1px solid var(--card-border);
    display:flex; align-items:center; justify-content:center; overflow:hidden;
  }
  .hero-visual .grid-lines{
    position:absolute; inset:0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 40px 40px; opacity:0.25;
  }
  .hero-visual .badge-float{
    position:relative; text-align:center; color:var(--ink-dim); font-size:0.95rem; padding: 0 30px;
  }
  .hero-visual .badge-float b{display:block; color:var(--amber-soft); font-size:2.4rem; font-weight:800; margin-bottom:8px;}

  section{ padding: 40px clamp(20px,5vw,64px); }
  .section-head{ display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:28px; gap:20px; flex-wrap:wrap;}
  .section-head h2{ font-size: clamp(1.5rem,2.5vw,2rem); font-weight:700; margin:0;}
  .section-head p{ color:var(--ink-dim); margin: 6px 0 0; font-size:0.95rem;}
  .view-all{ color: var(--teal); font-weight:600; font-size:0.9rem; white-space:nowrap;}

  .grid{
    display:grid; grid-template-columns: repeat(auto-fill, minmax(230px,1fr)); gap: 20px;
  }
  .product-card{
    background: var(--card); border:1px solid var(--card-border); border-radius: var(--radius-lg);
    overflow:hidden; display:flex; flex-direction:column;
  }
  .product-media{
    aspect-ratio: 1/1; background: var(--bg-2);
    display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;
  }
  .product-media img{width:100%;height:100%;object-fit:cover;}
  .placeholder-media{
    color: var(--ink-dim); font-size:0.85rem; text-align:center; padding: 20px;
    display:flex; flex-direction:column; align-items:center; gap:10px;
  }
  .placeholder-media .ph-icon{
    width:44px;height:44px;border-radius:50%; border:1.5px dashed var(--line);
    display:flex;align-items:center;justify-content:center; font-size:1.2rem;
  }
  .product-info{ padding: 16px 18px 18px; display:flex; flex-direction:column; gap:6px; flex:1;}
  .product-cat{ font-size:0.75rem; color: var(--teal); font-weight:600;}
  .product-name{ font-weight:700; font-size:1.02rem;}
  .product-price{ margin-top:auto; display:flex; align-items:center; justify-content:space-between; padding-top:10px;}
  .price-tag{ font-weight:800; color:var(--amber-soft);}
  .add-btn{
    background:transparent; border:1px solid var(--line); color:var(--ink);
    border-radius: 10px; width:36px;height:36px; font-size:1.1rem; cursor:pointer;
  }
  .add-btn:hover{border-color:var(--amber); color:var(--amber);}

  .featured-wrap{
    background: linear-gradient(120deg, #1c2140, #171b2b 60%);
    border:1px solid var(--card-border); border-radius: var(--radius-lg);
    padding: clamp(20px,4vw,42px); display:grid; grid-template-columns: 0.85fr 1.15fr; gap: 36px; align-items:center;
  }
  @media (max-width: 820px){ .featured-wrap{grid-template-columns:1fr;} }
  .featured-media{
    aspect-ratio: 4/5; border-radius: var(--radius-sm); background: var(--bg-2);
    border: 1.5px dashed var(--card-border);
    display:flex; align-items:center; justify-content:center; overflow:hidden;
  }
  .featured-media img{width:100%;height:100%;object-fit:cover;}
  .featured-tag{
    display:inline-flex; align-items:center; gap:8px; background: rgba(232,163,61,0.12);
    color: var(--amber-soft); padding: 6px 14px; border-radius:999px; font-size:0.82rem; font-weight:700; margin-bottom:16px; width:fit-content;
  }
  .featured-wrap h3{ font-size: clamp(1.6rem,3vw,2.2rem); margin:0 0 12px; font-weight:800;}
  .featured-wrap p{ color: var(--ink-dim); max-width:480px; margin:0 0 22px;}
  .featured-price-row{ display:flex; align-items:center; gap:18px; margin-bottom:24px;}
  .featured-price-row .price-tag{ font-size:1.5rem;}
  .btn-primary{
    background: var(--amber); color:#10131f; border:none; padding: 14px 30px;
    border-radius: 999px; font-weight:700; font-family:inherit; cursor:pointer; font-size:0.95rem;
  }

  .trust-strip{
    display:grid; grid-template-columns: repeat(4,1fr); gap:20px;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .trust-item{ text-align:center; padding: 8px;}
  .trust-item .num{ font-size:1.6rem; font-weight:800; color:var(--amber-soft);}
  .trust-item .lbl{ color:var(--ink-dim); font-size:0.85rem; margin-top:4px;}
  @media (max-width:700px){ .trust-strip{grid-template-columns: repeat(2,1fr);} }

  footer{
    padding: 40px clamp(20px,5vw,64px) 50px; border-top:1px solid var(--line);
    color: var(--ink-dim); font-size:0.9rem; display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px;
  }
</style>
</head>
